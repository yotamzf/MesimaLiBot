# ─────────────────────────────────────────────────────────────
# Example environment variables for the Telegram Task Bot (n8n)
# Copy to `.env` (which is git-ignored) OR set these as
# environment variables inside your n8n instance.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
# Referenced inside the workflow as: {{ $env.TELEGRAM_BOT_TOKEN }}
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# (Optional) The Google Sheets spreadsheet ID that stores the tasks.
# In the shipped workflow the ID is a placeholder (YOUR_GOOGLE_SHEETS_ID)
# inside each Google Sheets node — replace it after import, or wire it
# to this variable if you prefer.
TASKS_SPREADSHEET_ID=YOUR_GOOGLE_SHEETS_ID
